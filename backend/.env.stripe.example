# ===== STRIPE CONFIGURATION =====
# Clés Stripe (LIVE - Production)
STRIPE_SECRET_KEY=sk_live_votre_cle_secrete_ici
STRIPE_PUBLISHABLE_KEY=pk_live_votre_cle_publique_ici

# Webhook Secret (à obtenir depuis le dashboard Stripe)
# URL du webhook : https://votre-domaine.com/api/paiement/webhook
STRIPE_WEBHOOK_SECRET=whsec_votre_cle_webhook_ici

# URL Frontend pour les redirections après paiement
FRONTEND_URL=http://localhost:5175

# ===== INSTRUCTIONS =====
# 1. Copiez ces lignes dans votre fichier .env principal
# 2. Remplacez STRIPE_WEBHOOK_SECRET par votre vraie clé de webhook
#    Obtenez-la depuis : https://dashboard.stripe.com/webhooks
# 3. En production, changez FRONTEND_URL par votre vraie URL
